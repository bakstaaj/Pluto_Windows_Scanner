<Window x:Class="PlutoWindowsScannerGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pluto Scan" Height="860" Width="1260" MinHeight="720" MinWidth="1040"
        Background="#0f172a" Foreground="#e5e7eb"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="InputBrush" Color="#1f2937" />
        <SolidColorBrush x:Key="TextBrush" Color="#e5e7eb" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94a3b8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563eb" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1d4ed8" />
        </Style>

        <Style x:Key="ReadableMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#f8fafc" />
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource ReadableMenuItemStyle}" />
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1f2937" />
            <Setter Property="Foreground" Value="#e5e7eb" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#e5e7eb" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Pluto Scan" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="bakStaaJ Designs" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </DockPanel>

            <Menu Margin="0,8,0,0" Background="#f8fafc" Foreground="#111827">
                <MenuItem Header="_Scan">
                    <MenuItem Header="Start Scan" Click="StartScanButton_Click" />
                    <MenuItem Header="Stop Scan" Click="StopScanButton_Click" />
                    <Separator />
                    <MenuItem Header="Clear Active List" Click="ClearActiveButton_Click" />
                    <MenuItem Header="Use Selected for Single Hz" Click="UseSelectedForSingleButton_Click" />
                    <MenuItem Header="Use Selected for Live Center" Click="UseSelectedForLiveButton_Click" />
                    <Separator />
                    <MenuItem Header="Export CHIRP CSV" Click="ExportChirpButton_Click" />
                    <MenuItem Header="Open Last CSV" Click="OpenLastCsvButton_Click" />
                </MenuItem>

                <MenuItem Header="_Listen / Record">
                    <MenuItem Header="Listen / Record Selected or Single Hz" Click="ListenButton_Click" />
                    <Separator />
                    <MenuItem Header="Open Last WAV" Click="OpenLastWavButton_Click" />
                    <MenuItem Header="Delete Last WAV" Click="DeleteLastWavButton_Click" />
                    <MenuItem Header="Open Sessions Folder" Click="OpenSessionsFolderButton_Click" />
                </MenuItem>

                <MenuItem Header="_Profiles">
                    <MenuItem Header="Reload Listen Profiles" Click="ReloadListenProfilesButton_Click" />
                    <MenuItem Header="Open Listen Profiles JSON" Click="OpenListenProfilesJsonButton_Click" />
                </MenuItem>

                <MenuItem Header="_Live Spectrum">
                    <MenuItem Header="Start Live Spectrum" Click="StartLiveSpectrumButton_Click" />
                    <MenuItem Header="Stop Live Spectrum" Click="StopLiveSpectrumButton_Click" />
                </MenuItem>


                <MenuItem Header="_View">
                    <MenuItem Header="Expand All Sections" Click="ExpandAllSectionsMenuItem_Click" />
                    <MenuItem Header="Focus Charts / Waterfall" Click="FocusChartsMenuItem_Click" />
                    <MenuItem Header="Focus Active Channels" Click="FocusActiveChannelsMenuItem_Click" />
                    <MenuItem Header="Open Run Log Window" Click="OpenRunLogWindowMenuItem_Click" />
                </MenuItem>

                <MenuItem Header="_Config">
                    <MenuItem Header="Open Config Folder" Click="OpenConfigButton_Click" />
                    <MenuItem Header="Open Sessions Folder" Click="OpenSessionsFolderButton_Click" />
                    <Separator />
                    <MenuItem Header="Save Configuration" Click="SaveConfigButton_Click" />
                    <MenuItem Header="Reload Bands" Click="ReloadBandsButton_Click" />
                    <MenuItem Header="Reset Defaults" Click="ResetConfigButton_Click" />
                </MenuItem>
            
                <MenuItem Header="Audio">
                    <MenuItem Header="Record Selected / Single Hz" Click="ListenButton_Click" />
                    <MenuItem Header="Listen Live Selected / Single Hz" Click="ListenLiveButton_Click" />
                    <MenuItem Header="Listen + Record Selected / Single Hz" Click="ListenAndRecordButton_Click" />
                </MenuItem>
</Menu>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="#0f172a" Foreground="#111827">
            <TabItem Header="Scanner">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ScanControlsRow" Height="Auto" />
                        <RowDefinition x:Name="ChartsRow" Height="2.1*" />
                        <RowDefinition x:Name="ActiveChannelsRow" Height="2.2*" />
                        <RowDefinition x:Name="RunLogRow" Height="0" />
                    </Grid.RowDefinitions>

                                          <Expander x:Name="ScanControlsExpander" Grid.Row="0" Header="Scan Setup" IsExpanded="True" Expanded="ScannerSectionExpander_Changed" Collapsed="ScannerSectionExpander_Changed">
<GroupBox Header="Scan Setup" Background="{StaticResource PanelBrush}">
                          <Grid Margin="2">
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>

                              <GroupBox Grid.Row="0" Grid.Column="0" Header="Scan Target" Background="{StaticResource PanelBrush}">
                                  <Grid Margin="4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="100" />
                                          <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                      <Label Grid.Row="0" Grid.Column="0" Content="Mode" />
                                      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ScanModeCombo" SelectionChanged="ScanModeCombo_SelectionChanged" MinWidth="180">
                                          <ComboBoxItem Content="Standard Band" IsSelected="True" />
                                          <ComboBoxItem Content="Frequency Range" />
                                          <ComboBoxItem Content="Single Frequency" />
                                      </ComboBox>

                                      <Label Grid.Row="0" Grid.Column="2" Content="Band" />
                                      <ComboBox Grid.Row="0" Grid.Column="3" x:Name="BandCombo" DisplayMemberPath="Name" SelectionChanged="BandCombo_SelectionChanged" MinWidth="240" />

                                      <Label Grid.Row="1" Grid.Column="0" Content="Single Hz" />
                                      <TextBox Grid.Row="1" Grid.Column="1" x:Name="SingleFreqText" Text="162550000" MinWidth="150" />

                                      <Label Grid.Row="1" Grid.Column="2" Content="Step Hz" />
                                      <TextBox Grid.Row="1" Grid.Column="3" x:Name="StepHzText" Text="25000" MinWidth="110" />

                                      <Label Grid.Row="2" Grid.Column="0" Content="Start Hz" />
                                      <TextBox Grid.Row="2" Grid.Column="1" x:Name="StartFreqText" Text="162400000" MinWidth="150" />

                                      <Label Grid.Row="2" Grid.Column="2" Content="Stop Hz" />
                                      <TextBox Grid.Row="2" Grid.Column="3" x:Name="StopFreqText" Text="162550000" MinWidth="150" />
                                  </Grid>
                              </GroupBox>

                              <GroupBox Grid.Row="0" Grid.Column="1" Header="Device / Receiver" Background="{StaticResource PanelBrush}">
                                  <Grid Margin="4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="115" />
                                          <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                      <Label Grid.Row="0" Grid.Column="0" Content="URI" />
                                      <TextBox Grid.Row="0" Grid.Column="1" x:Name="UriText" Text="ip:192.168.2.1" MinWidth="150" />

                                      <Label Grid.Row="0" Grid.Column="2" Content="Rate Hz" />
                                      <TextBox Grid.Row="0" Grid.Column="3" x:Name="RateText" Text="1000000" MinWidth="120" />

                                      <Label Grid.Row="1" Grid.Column="0" Content="RF BW Hz" />
                                      <TextBox Grid.Row="1" Grid.Column="1" x:Name="BwText" Text="1000000" MinWidth="120" />

                                      <Label Grid.Row="1" Grid.Column="2" Content="Threshold dBFS" />
                                      <TextBox Grid.Row="1" Grid.Column="3" x:Name="SquelchText" Text="-40" MinWidth="80" />

                                      <Label Grid.Row="2" Grid.Column="0" Content="RX Mode" />
                                      <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RxModeCombo" MinWidth="120">
                                          <ComboBoxItem Content="auto" IsSelected="True" />
                                          <ComboBoxItem Content="single" />
                                          <ComboBoxItem Content="dual" />
                                      </ComboBox>

                                      <Label Grid.Row="2" Grid.Column="2" Content="RX Combine" />
                                      <ComboBox Grid.Row="2" Grid.Column="3" x:Name="RxCombineCombo" MinWidth="120">
                                          <ComboBoxItem Content="max" IsSelected="True" />
                                          <ComboBoxItem Content="average" />
                                          <ComboBoxItem Content="separate" />
                                      </ComboBox>
                                  </Grid>
                              </GroupBox>

                              <GroupBox Grid.Row="1" Grid.Column="0" Header="Scan Behavior" Background="{StaticResource PanelBrush}">
                                  <Grid Margin="4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                      <CheckBox Grid.Row="0" Grid.Column="0" x:Name="VerboseCheck" Content="Verbose log" Margin="6" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                      <CheckBox Grid.Row="0" Grid.Column="1" x:Name="RepeatScanCheck" Content="Repeat scan" Margin="6" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />

                                      <Label Grid.Row="0" Grid.Column="2" Content="Delay sec" />
                                      <TextBox Grid.Row="0" Grid.Column="3" x:Name="RepeatDelayText" Text="2" Width="80" HorizontalAlignment="Left" />

                                      <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                                 Text="Actions are available from the Scan, Listen / Record, Live Spectrum, and View menus."
                                                 Foreground="{StaticResource MutedTextBrush}"
                                                 Margin="6,8,0,0"
                                                 TextWrapping="Wrap" />
                                  </Grid>
                              </GroupBox>

                              <GroupBox Grid.Row="1" Grid.Column="1" Header="Listen Profile" Background="{StaticResource PanelBrush}">
                                  <Grid Margin="4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
</Grid.RowDefinitions>

                                      <Label Grid.Row="0" Grid.Column="0" Content="Profile" />
                                      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ListenProfileComboBox" SelectedIndex="0" MinWidth="260">
                                          <ComboBoxItem Content="Auto by Mode"/>
                                          <ComboBoxItem Content="NOAA/NFM Clean Normal"/>
                                          <ComboBoxItem Content="NOAA/NFM Clean Invert-Q"/>
                                          <ComboBoxItem Content="Ham FM NFM"/>
                                          <ComboBoxItem Content="Airband AM"/>
                                          <ComboBoxItem Content="Broadcast FM WBFM"/>
                                          <ComboBoxItem Content="Digital Detect Only"/>
                                      </ComboBox>

                                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                 Text="Profiles are loaded from configs\listen_profiles.json."
                                                 Foreground="{StaticResource MutedTextBrush}"
                                                 Margin="6,8,0,0"
                                                 TextWrapping="Wrap" />
                                  
                                      <Label Grid.Row="2" Grid.Column="0" Content="Audio Action" />
                                      <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AudioActionCombo" SelectedIndex="0" MinWidth="260" SelectionChanged="AudioActionCombo_SelectionChanged">
                                          <ComboBoxItem Content="Record" IsSelected="True" />
                                          <ComboBoxItem Content="Listen Live" />
                                          <ComboBoxItem Content="Listen + Record" />
                                      </ComboBox>
</Grid>
                              
                                  
</GroupBox>

                              <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Live Spectrum" Background="{StaticResource PanelBrush}">
                                  <Grid Margin="4">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="120" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="80" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="90" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="105" />
                                          <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
</Grid.RowDefinitions>

                                      <Label Grid.Row="0" Grid.Column="0" Content="Center Hz" />
                                      <TextBox Grid.Row="0" Grid.Column="1" x:Name="LiveCenterFreqText" Text="162550000" MinWidth="130" />

                                      <Label Grid.Row="0" Grid.Column="2" Content="FFT" />
                                      <TextBox Grid.Row="0" Grid.Column="3" x:Name="LiveFftText" Text="512" MinWidth="70" />

                                      <Label Grid.Row="0" Grid.Column="4" Content="Average" />
                                      <TextBox Grid.Row="0" Grid.Column="5" x:Name="LiveAvgText" Text="2" MinWidth="70" />

                                      <Label Grid.Row="0" Grid.Column="6" Content="Interval ms" />
                                      <TextBox Grid.Row="0" Grid.Column="7" x:Name="LiveIntervalText" Text="500" MinWidth="80" />

                                      <Label Grid.Row="1" Grid.Column="0" Content="Gain Mode" />
                                      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LiveGainModeCombo" MinWidth="130">
                                          <ComboBoxItem Content="slow_attack" IsSelected="True" />
                                          <ComboBoxItem Content="fast_attack" />
                                          <ComboBoxItem Content="manual" />
                                      </ComboBox>

                                      <Label Grid.Row="1" Grid.Column="2" Content="Gain dB" />
                                      <TextBox Grid.Row="1" Grid.Column="3" x:Name="LiveGainDbText" Text="" MinWidth="70" />

                                      <TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4"
                                                 x:Name="LiveSpectrumStatusText"
                                                 Text="Live spectrum idle"
                                                 Foreground="{StaticResource MutedTextBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,0,0" />
                                  
                                      <StackPanel Grid.Row="2"
                                                  Grid.ColumnSpan="8"
                                                  Orientation="Horizontal"
                                                  Margin="6,8,0,0">
                                          <Button x:Name="LiveShiftDownButton"
                                                  Content="Shift Down 50%"
                                                  Click="LiveShiftDownButton_Click"
                                                  MinWidth="120" />
                                          <Button x:Name="LiveShiftUpButton"
                                                  Content="Shift Up 50%"
                                                  Click="LiveShiftUpButton_Click"
                                                  MinWidth="120"
                                                  Margin="8,0,0,0" />
                                          <TextBlock x:Name="LiveShiftStatusText"
                                                     Text="Shift uses 50% of current visible span."
                                                     Foreground="{StaticResource MutedTextBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0,0,0" />
                                      </StackPanel>
</Grid>
                              </GroupBox>

                              <!-- Hidden compatibility buttons: menus call these handlers and code-behind still references these named controls. -->
                              <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed">
                                  <Button x:Name="StartScanButton" Content="Start Scan" Click="StartScanButton_Click" />
                                  <Button x:Name="StopScanButton" Content="Stop" Click="StopScanButton_Click" IsEnabled="False" />
                                  <Button x:Name="ClearActiveButton" Content="Clear List" Click="ClearActiveButton_Click" />
                                  <Button x:Name="UseSelectedForSingleButton" Content="Use Selected for Single Hz" Click="UseSelectedForSingleButton_Click" />
                                  <Button x:Name="ReloadListenProfilesButton" Content="Reload" Click="ReloadListenProfilesButton_Click" />
                                  <Button x:Name="OpenListenProfilesJsonButton" Content="Open JSON" Click="OpenListenProfilesJsonButton_Click" />
                                  <Button x:Name="ListenButton" Content="Listen / Record Selected" Click="ListenButton_Click" />
                                  <Button x:Name="OpenLastWavButton" Content="Open Last WAV" Click="OpenLastWavButton_Click" />
                                  <Button x:Name="DeleteLastWavButton" Content="Delete Last WAV" Click="DeleteLastWavButton_Click" />
                                  <Button x:Name="OpenSessionsFolderButton" Content="Open Sessions Folder" Click="OpenSessionsFolderButton_Click" />
                                  <Button x:Name="ExportChirpButton" Content="Export CHIRP CSV" Click="ExportChirpButton_Click" />
                                  <Button x:Name="OpenLastCsvButton" Content="Open Last CSV" Click="OpenLastCsvButton_Click" />
                                  <Button x:Name="UseSelectedForLiveButton" Content="Use Selected" Click="UseSelectedForLiveButton_Click" />
                                  <Button x:Name="StartLiveSpectrumButton" Content="Start Live Spectrum" Click="StartLiveSpectrumButton_Click" />
                                  <Button x:Name="StopLiveSpectrumButton" Content="Stop Live" Click="StopLiveSpectrumButton_Click" IsEnabled="False" />
                              </StackPanel>
                          </Grid>
                      </GroupBox>
                      </Expander>

                                          <Expander x:Name="ChartsExpander" Grid.Row="1" Header="Spectrum and Waterfall" IsExpanded="True" Expanded="ScannerSectionExpander_Changed" Collapsed="ScannerSectionExpander_Changed">
<Grid Grid.Row="1" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Frequency Spectrum" Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Canvas x:Name="SpectrumCanvas" Background="#020617" SizeChanged="ChartCanvas_SizeChanged" MouseLeftButtonDown="SpectrumCanvas_MouseLeftButtonDown" ClipToBounds="True" MouseMove="SpectrumCanvas_MouseMove" MouseLeave="ChartCanvas_MouseLeave" />
                                <TextBlock x:Name="SpectrumCaption" Text="Run a scan or start live spectrum to populate this chart" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Waterfall History" Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Canvas x:Name="WaterfallCanvas" Background="#020617" SizeChanged="ChartCanvas_SizeChanged" MouseLeftButtonDown="WaterfallCanvas_MouseLeftButtonDown" ClipToBounds="True" MouseMove="WaterfallCanvas_MouseMove" MouseLeave="ChartCanvas_MouseLeave" />
                                <TextBlock x:Name="WaterfallCaption" Text="Waterfall rows update from scans and live spectrum frames" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                      </Expander>

                                          <Expander x:Name="ActiveChannelsExpander" Grid.Row="2" Header="Detected Active Channels" IsExpanded="True" Expanded="ScannerSectionExpander_Changed" Collapsed="ScannerSectionExpander_Changed">
<GroupBox Grid.Row="2" Header="Detected Active Channels" Background="{StaticResource PanelBrush}">
                        <Grid>
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="*" />
                                      </Grid.RowDefinitions>

                                      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="4">
                                          <Grid>
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="150" />
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="90" />
                                                  <ColumnDefinition Width="140" />
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="80" />
                                              </Grid.ColumnDefinitions>

                                              <TextBlock Grid.Column="0"
                                                         Text="Threshold dBFS"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextBrush}"
                                                         ToolTip="Adjusts the signal level required before a channel is considered active. Less negative is stricter; more negative is more sensitive." />
                                              <Slider Grid.Column="1"
                                                      x:Name="ActiveThresholdSlider"
                                                      Minimum="-100"
                                                      Maximum="-30"
                                                      TickFrequency="1"
                                                      IsSnapToTickEnabled="False"
                                                      Value="-40"
                                                      VerticalAlignment="Center"
                                                      ValueChanged="ActiveFilterSlider_ValueChanged" />
                                              <TextBlock Grid.Column="2"
                                                         x:Name="ActiveThresholdSliderText"
                                                         Text="-65.0 dBFS"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,0,0"
                                                         Foreground="{StaticResource MutedTextBrush}" />

                                              <TextBlock Grid.Column="3"
                                                         Text="Min SNR dB"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextBrush}"
                                                         ToolTip="Adjusts how far above the local noise floor a signal must be before it is listed as active." />
                                              <Slider Grid.Column="4"
                                                      x:Name="ActiveSnrSlider"
                                                      Minimum="0"
                                                      Maximum="30"
                                                      TickFrequency="0.5"
                                                      IsSnapToTickEnabled="False"
                                                      Value="20"
                                                      VerticalAlignment="Center"
                                                      ValueChanged="ActiveFilterSlider_ValueChanged" />
                                              <TextBlock Grid.Column="5"
                                                         x:Name="ActiveSnrSliderText"
                                                         Text="4.0 dB"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,0,0"
                                                         Foreground="{StaticResource MutedTextBrush}" />
                                          </Grid>
                                      </Border>

                                      <DataGrid x:Name="ActiveChannelsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="ActiveChannelsGrid_MouseDoubleClick"
                                  Background="#020617" Foreground="#e5e7eb" RowBackground="#111827" AlternatingRowBackground="#0f172a"
                                  GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Freq MHz" Binding="{Binding FrequencyMhz}" Width="110" />
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80" />
                                <DataGridTextColumn Header="RX" Binding="{Binding EffectiveRxMode}" Width="80" />
                                <DataGridTextColumn Header="RX1 dBFS" Binding="{Binding Rx1Dbfs}" Width="90" />
                                <DataGridTextColumn Header="RX2 dBFS" Binding="{Binding Rx2Dbfs}" Width="90" />
                                <DataGridTextColumn Header="Last dBFS" Binding="{Binding LastDbfs}" Width="90" />
                                <DataGridTextColumn Header="Peak dBFS" Binding="{Binding PeakDbfs}" Width="90" />
                                <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdDbfs}" Width="90" />
                                <DataGridTextColumn Header="Hits" Binding="{Binding DetectedCount}" Width="70" />
                                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenDisplay}" Width="95" />
                                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                                  </Grid>
                    </GroupBox>
                      </Expander>

                                          <Expander x:Name="RunLogExpander" Visibility="Collapsed" Grid.Row="3" Header="Run Log" IsExpanded="False" Expanded="ScannerSectionExpander_Changed" Collapsed="ScannerSectionExpander_Changed">
<GroupBox Grid.Row="3" Header="Run Log" Background="{StaticResource PanelBrush}">
                        <TextBox x:Name="LogText" Background="#020617" Foreground="#d1d5db" BorderBrush="{StaticResource BorderBrush}"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </GroupBox>
                      </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Configuration">
                <ScrollViewer Margin="8">
                    <StackPanel>
                          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="6">
                              <StackPanel Orientation="Horizontal">
                                  <Button x:Name="SaveConfigTopButton"
                                          Content="Save Configuration"
                                          Click="SaveConfigButton_Click"
                                          FontWeight="SemiBold"
                                          MinWidth="150" />
                                  <TextBlock Text="  Save after changing scanner samples, settle time, channel low-pass, or SNR settings."
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource MutedTextBrush}" />
                              </StackPanel>
                          </Border>

                          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="6">
                              <TextBlock Text="Configuration actions are available from the Config menu."
                                         Foreground="{StaticResource MutedTextBrush}" />
                          </Border>

                        <GroupBox Header="Application Paths and Defaults" Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                                                      <RowDefinition Height="Auto" />
                                      <RowDefinition Height="Auto" />
                                      <RowDefinition Height="Auto" />
                                      <RowDefinition Height="Auto" />
                                      <RowDefinition Height="Auto" />
                                      <RowDefinition Height="Auto" />
</Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="Project root" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RepoRootText" IsReadOnly="True" />
                                <Label Grid.Row="1" Grid.Column="0" Content="Sessions folder" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SessionsDirText" />
                                <Label Grid.Row="2" Grid.Column="0" Content="Bands CSV path" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="BandsCsvText" />
                                <Label Grid.Row="3" Grid.Column="0" Content="Default listen seconds" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ListenSecondsText" Text="30" />
                                <Label Grid.Row="4" Grid.Column="0" Content="Default CHIRP mode" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DefaultChirpModeText" Text="NFM" />
                                  <Label Grid.Row="5" Grid.Column="0" Content="Active min SNR dB" />
                                  <TextBox Grid.Row="5" Grid.Column="1" x:Name="ActiveChannelMinSnrDbText" Text="20.0" />
                                  <Label Grid.Row="6" Grid.Column="0" Content="Scanner channel LP Hz" />
                                  <TextBox Grid.Row="6" Grid.Column="1" x:Name="ScannerChannelLowpassHzText" Text="12000" />
                                  <Label Grid.Row="7" Grid.Column="0" Content="Scanner samples" />
                                  <TextBox Grid.Row="7" Grid.Column="1" x:Name="ScannerSamplesText" Text="8192" />
                                  <Label Grid.Row="8" Grid.Column="0" Content="Scanner settle ms" />
                                  <TextBox Grid.Row="8" Grid.Column="1" x:Name="ScannerSettleMsText" Text="50" />
                                  <Label Grid.Row="9" Grid.Column="0" Content="Progress overhead ms" />
                                  <TextBox Grid.Row="9" Grid.Column="1" x:Name="ScannerProgressOverheadMsText" Text="95" />
                                  <Label Grid.Row="10" Grid.Column="0" Content="Help Level" />
                                  <ComboBox Grid.Row="10" Grid.Column="1" x:Name="HelpLevelCombo" SelectionChanged="HelpLevelCombo_SelectionChanged" MinWidth="160">
                                      <ComboBoxItem Content="Novice" />
                                      <ComboBoxItem Content="Intermediate" IsSelected="True" />
                                      <ComboBoxItem Content="Expert" />
                                  </ComboBox>





                                <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Margin="6,10" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="The GUI reads standard band choices from configs\bands.csv. If you edit that CSV, restart the GUI or click Reload Bands." />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header=" Development Notes" Background="{StaticResource PanelBrush}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"><Run Text="This  Phase 2 build adds a live spectrum/waterfall stream using pluto_spectrum_stream.exe while preserving the Phase 1 scan/listen/export workflow. Live spectrum frames are parsed from SPECTRUM CSV output and rendered at the top of the Scanner tab." /></TextBlock>
                        </GroupBox>

                        <WrapPanel>
                            <Button x:Name="SaveConfigButton" Content="Save Configuration" Click="SaveConfigButton_Click" Visibility="Collapsed" />
                            <Button x:Name="ReloadBandsButton" Content="Reload Bands" Click="ReloadBandsButton_Click" Visibility="Collapsed" />
                            <Button x:Name="ResetConfigButton" Content="Reset Defaults" Click="ResetConfigButton_Click" Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Background="#111827" Foreground="#e5e7eb" Margin="6,8,6,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanProgressText"
                               Text="Scan idle"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,8,0" />
                    <ProgressBar x:Name="ScanProgressBar"
                                 Width="220"
                                 Height="14"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0" />
                </StackPanel>
            </StatusBarItem>

            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource TextBrush}" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FooterText"
                           Text="Pluto Scan - bakStaaJ Designs"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
